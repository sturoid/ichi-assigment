      "status": "known_gap",
      "html": "M11-label-ranges-and-conjunctions.html",
      "title": "Row labels with 'and' / 'through' instead of commas",
      "why": "Code labels use \"A-1 and A-2\", \"H-1 through H-3\". A comma-only split leaves \"R-2 and R-4\" as one atom and cannot expand a range.",
      "gap": "Only commas split labels. Fix: split on ', ' and ' and '; expand 'X-n through X-m' when both ends share a prefix.",
      "gap_signature": "no cell for {'occupancy': 'A-2'",
      "spec": {
        "table_id": "SYN-RANGES",
        "row_dims": [
          "occupancy"
        ],
        "col_dim": "construction",
        "multi_value_dims": [
          "occupancy"
