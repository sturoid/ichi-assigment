      "kind": "matrix",
      "status": "pass",
      "html": "M10-header-repeated-mid-table.html",
      "title": "Header block repeated mid-table (page break)",
      "why": "Multi-page tables reprint headers. The repeat must be dropped and reported, not turned into data rows. (Duplicate keys in a law table stay a hard error.)",
      "spec": "$mini_height_spec",
      "expect": {
