      "kind": "matrix",
      "status": "pass",
      "html": "M02-headers-plain-td-in-tbody.html",
      "title": "Header rows are plain <td> inside <tbody>, no bold",
      "why": "The real 504.3 scrape puts headers in <tbody> as <td>; only a CSS class marks them. If a scrape drops styling, headers must still be found from structure (merged cells spanning down to the data).",
      "spec": "$mini_height_spec",
      "expect": {
        "header_rows": [
          0,
          1,
          2
        ],
        "data_row_count": 5,
        "same_index_as": "M01",
        "warnings_empty": true
