    {
      "id": "M05",
      "kind": "matrix",
      "status": "known_gap",
      "html": "M05-transposed.html",
      "title": "Transposed: construction down the left, occupancy/sprinkler across the top",
      "why": "Some code tables put two dimensions in the column headers (e.g. IBC Table 508.4: occupancy groups across the top, each split into S / NS). A lookup by dimension name must not care which axis a dimension is on.",
      "gap": "MatrixSpec supports one column dimension. Fix: col_dims list, one name per header level.",
      "gap_signature": "col_dims",
      "spec": {
        "table_id": "SYN-MINI-HEIGHT-T",
        "row_dims": [
          "construction"
        ],
        "col_dims": [
          "occupancy",
          "sprinkler"
        ],
        "multi_value_dims": [
          "occupancy"
        ],
        "tokens": {
          "UL": "unlimited"
        },
        "unit": "ft"
      },
      "expect": {
        "data_row_count": 3,
        "lookups": "$mini_height_lookups"
      }
    },
    {
      "id": "M06",
      "kind": "matrix",
      "status": "known_gap",
      "html": "M06-group-header-rows.html",
      "title": "Occupancy given by full-width group rows (\"GROUP R\") instead of a label column",
      "why": "Group sub-heading rows are common in code tables and schedules. The group row's label applies to the rows under it and must become neither a data row nor a header row.",
      "gap": "No group-row concept; the bold group rows are also absorbed into the header. Fix: detect full-width label rows in the body and carry them as a dimension; strip a 'GROUP(S)' prefix via spec.",
      "gap_signature": "group_row_dim",
      "spec": {
        "table_id": "SYN-MINI-HEIGHT-G",
        "row_dims": [
          "sprinkler"
        ],
        "group_row_dim": "occupancy",
        "col_dim": "construction",
        "multi_value_dims": [
          "occupancy"
        ],
        "column_key": "construction_type",
        "tokens": {
          "UL": "unlimited"
        },
        "unit": "ft"
      },
      "expect": {
        "header_rows": [
          0,
          1
        ],
        "data_row_count": 5,
        "lookups": "$mini_height_lookups"
      }
    },
