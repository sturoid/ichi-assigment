    {
      "id": "M09",
      "kind": "matrix",
      "status": "known_gap",
      "html": "M09-caption-title-and-footer-notes.html",
      "title": "<caption>, a title row above the headers, and a footnote row below the data",
      "why": "Scraped tables often carry the table number in <caption> and the legend/footnotes as a final full-width row. The caption is the table's identity; the footer must become notes, not a data row.",
      "gap": "A full-width last row is read as data, and <caption> text is discarded. Fix: classify trailing full-width rows as notes; store caption on the grid.",
      "gap_signature": "data_row_count",
      "spec": "$mini_height_spec",
      "expect": {
        "data_row_count": 5,
        "caption": "TABLE 999.1 MINI HEIGHT (SYNTHETIC)",
        "title_contains": "ALLOWABLE HEIGHT",
        "same_index_as": "M01",
        "warnings_empty": true
      }
    },
    {
