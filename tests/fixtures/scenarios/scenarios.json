{
  "_about": "Table-structure scenarios for the htmlParser. See README.md for the catalogue. status 'pass' = must pass now. status 'known_gap' = must currently fail, AND the failure message must contain gap_signature (so a typo or unrelated error can't masquerade as the known gap). When a gap is fixed the runner fails until status is changed to 'pass'. Synthetic values are made up and are NOT code.",
  "shared": {
    "mini_height_spec": {
      "table_id": "SYN-MINI-HEIGHT",
      "row_dims": [
        "occupancy",
        "sprinkler"
      ],
      "col_dim": "construction",
      "multi_value_dims": [
        "occupancy"
      ],
      "column_key": "construction_type",
      "tokens": {
        "UL": "unlimited"
      },
      "unit": "ft"
    },
    "mini_height_lookups": [
      {
        "dims": {
          "occupancy": "A",
          "sprinkler": "NS",
          "construction": "I-A"
        },
        "value": "UL"
      },
      {
        "dims": {
          "occupancy": "B",
          "sprinkler": "S",
          "construction": "II-B"
        },
        "value": 75
      },
      {
        "dims": {
          "occupancy": "R",
          "sprinkler": "S13R",
          "construction": "V-B"
        },
        "value": 60
      },
      {
        "dims": {
          "occupancy": "R",
          "sprinkler": "NS",
          "construction": "V-B"
        },
        "value": 40
      },
      {
        "dims": {
          "occupancy": "A",
          "sprinkler": "S",
          "construction": "V-B"
        },
        "value": 60
      },
      {
        "dims": {
          "occupancy": "R",
          "sprinkler": "S",
          "construction": "II-B"
        },
        "value": 75
      },
      {
        "dims": {
          "occupancy": "R",
          "sprinkler": "S13R",
          "construction": "I-A"
        },
        "value": 60
      }
    ]
  },
  "scenarios": [
    {
      "id": "M01",
      "kind": "matrix",
      "status": "pass",
      "html": "M01-baseline-thead-th.html",
      "title": "Baseline: <thead>, <th>, rowspanned row labels",
      "why": "Control case. M02-M07 carry the same data in a different shape and must give identical lookups.",
      "spec": "$mini_height_spec",
      "expect": {
        "header_rows": [
          0,
          1,
          2
        ],
        "data_row_count": 5,
        "column_keys": [
          "I-A",
          "II-B",
          "V-B"
        ],
        "cell_count": 15,
        "index_size": 21,
        "lookups": "$mini_height_lookups",
        "absent_lookups": [
          {
            "occupancy": "A",
            "sprinkler": "S13R",
            "construction": "I-A"
          },
          {
            "occupancy": "R",
            "sprinkler": "NS",
            "construction": "IV-HT"
          }
        ],
        "bad_lookup_dims": [
          {
            "occupancy": "R",
            "construction": "V-B"
          },
          {
            "occupancy": "R",
            "sprinkler": "NS",
            "construction": "V-B",
            "floor": "1"
          }
        ],
        "warnings_empty": true,
        "review_items_empty": true
      }
    },
    {
